rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 내 문서(users/내uid)만 읽고 쓸 수 있어요
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 아이디 → uid 찾기표: 로그인한 사람은 읽을 수 있고, 내 uid로 한 번만 만들 수 있어요
    match /usernames/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }

    // 두 사람 사이의 대화: 참가자만 읽고 쓸 수 있어요
    match /chats/{cid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2;
      allow update: if request.auth != null && request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members;

      match /messages/{mid} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members && request.resource.data.from == request.auth.uid;
        // 받기(done)와 투표(votes)만 참가자가 고칠 수 있어요
        allow update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'votes']);
      }
    }
  }
}
