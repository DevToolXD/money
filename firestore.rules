rules_version = '2';

// 서버(규칙)가 지키는 것
//  - 익명 로그인은 아무것도 못 해요. 아이디·비밀번호로 가입한 계정만 써요.
//  - 토큰 지갑(wallets)은 값을 마음대로 못 바꿔요: 이자는 시간이 흐른 만큼만, 상품은 정해진 값만, 선물은 보낸 만큼만 빠지고 받은 만큼만 늘어요.
//  - 쓰기는 속도를 제한하고(메시지 0.6초, 지갑 2초), 모든 글자와 사진은 크기와 모양을 검사해요.
//  - 사람 정보는 profiles 한 곳에만 두고, 내 것만 만들고 사진만 바꿀 수 있어요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function myId() { return request.auth.token.email.split('@')[0]; }
    function img(v, max) {
      return v is string && v.size() <= max && v.matches('^data:image/(jpeg|png);base64,[A-Za-z0-9+/]+={0,2}$');
    }
    function photoOk(v) { return v == '' || img(v, 40000); }

    // ----- 사람 정보: 로그인한 사람은 볼 수 있고(찾기는 한 번에 20명까지), 내 것만 만들어요 -----
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['id', 'name', 'photo'])
        && request.resource.data.id == myId()
        && request.resource.data.id.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.name is string
        && (request.resource.data.name.matches('^[가-힣]{2,6}$') || request.resource.data.name.matches('^[A-Za-z][A-Za-z ]{1,38}[A-Za-z]$')
            || request.resource.data.name == request.resource.data.id) // 이름이 없던 옛 계정은 아이디를 이름으로 써요
        && photoOk(request.resource.data.photo);
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo'])
        && photoOk(request.resource.data.photo);
      allow delete: if isOwner() && adminDelOk();
    }

    // ----- 내 설정 (나만 읽고 써요) -----
    match /users/{uid} {
      allow read: if isMe(uid);
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['profile', 'walls', 'updatedAt'])
        && (!('profile' in request.resource.data) || (
              request.resource.data.profile.keys().hasOnly(['name', 'bio'])
              && request.resource.data.profile.name is string && request.resource.data.profile.name.size() <= 30
              && request.resource.data.profile.bio is string && request.resource.data.profile.bio.size() <= 120))
        && (!('walls' in request.resource.data) || (request.resource.data.walls is map && request.resource.data.walls.size() <= 200))
        && (!('profile' in request.resource.data) || !exists(/databases/$(database)/documents/profiles/$(uid)) || request.resource.data.profile.name == get(/databases/$(database)/documents/profiles/$(uid)).data.name);
      allow delete: if isOwner() && adminDelOk();
    }

    // ----- 토큰 지갑 -----
    function prices() {
      return {'5': 20, '10': 70, '15': 144, '20': 243, '25': 362, '30': 503, '35': 664, '40': 844, '45': 1044, '50': 1262};
    }
    // 연이율 r%를 초당 이율로 (ln(1+r/100) / 1년의 초)
    function perSec() {
      return {'5': 0.00000000154712596, '10': 0.00000000302226598, '15': 0.00000000443182212, '20': 0.00000000578137864, '25': 0.00000000707583559,
              '30': 0.00000000831951625, '35': 0.00000000951625420, '40': 0.0000000106694646, '45': 0.0000000117822031, '50': 0.0000000128572142};
    }
    // 복리로 쌓일 수 있는 이자의 위쪽 한계: x + x², x = 초당 이율 × 걸린 초 (e^x - 1 보다 항상 커요)
    function maxGain(bal, rate, secs) {
      return bal * (perSec()[string(rate)] * secs + perSec()[string(rate)] * secs * perSec()[string(rate)] * secs);
    }
    function msgPath(cid, mid) { return /databases/$(database)/documents/chats/$(cid)/messages/$(mid); }
    function companyPath(uid) { return /databases/$(database)/documents/companies/$(uid); }
    function jobPath(uid) { return /databases/$(database)/documents/jobs/$(uid); }
    function walletPath(uid) { return /databases/$(database)/documents/wallets/$(uid); }
    // ----- 관리자(오너 계정 한 명). 관리 행동은 인증토큰 3개가 서버에 있는 것과 같을 때만, 5분 안에, 한 번만 돼요 -----
    function isOwner() { return signedIn() && request.auth.token.email == 'owner@money-sim.app'; }
    function adminPath() { return /databases/$(database)/documents/adminAuth/$(request.auth.uid); }
    // 행동 확인: 인증토큰 3개가 같고, 시간이 남아 있고, 이 묶음에서 토큰을 없애요 (한 번만 쓸 수 있어요)
    function adminOk(tk) {
      return isOwner() && exists(adminPath()) && get(adminPath()).data.tk == tk
        && request.time.toMillis() < get(adminPath()).data.exp && !existsAfter(adminPath());
    }
    // 지우기 확인: 토큰이 살아 있고 이 묶음에서 없애요
    function adminDelOk() {
      return isOwner() && exists(adminPath()) && request.time.toMillis() < get(adminPath()).data.exp && !existsAfter(adminPath());
    }

    // ----- 랭킹: 내 지갑 잔액과 똑같은 값만 쓸 수 있어요 (이름·아이디도 내 프로필과 같아야 해요). 20초에 한 번만 갱신해요 -----
    match /ranks/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create: if rankOk(uid);
      allow update: if rankOk(uid) && request.time >= resource.data.at + duration.value(20, 's');
    }
    function rankOk(uid) {
      return isMe(uid)
        && request.resource.data.keys().hasOnly(['id', 'name', 'bal', 'at'])
        && request.resource.data.at == request.time
        && request.resource.data.bal is int
        && request.resource.data.bal == get(walletPath(uid)).data.bal
        && request.resource.data.id == get(/databases/$(database)/documents/profiles/$(uid)).data.id
        && request.resource.data.name == get(/databases/$(database)/documents/profiles/$(uid)).data.name;
    }

    // ----- 회사: 한 사람이 회사를 여러 개 가질 수 있어요. 창업은 10 토큰이 빠지는 지갑 쓰기와 같은 묶음에서만.
    //       사장(owner)은 채용 공고(모집 인원 늘리기)와 업종 바꾸기만 해요. 직원이 되거나 그만두는 것은 일자리 기록(jobs)과 같은 묶음에서 인원이 함께 바뀔 때만 -----
    match /companies/{cid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'logo', 'kind', 'products', 'open', 'staff', 'owner', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[^<>]{1,20}$')
        && photoOk(request.resource.data.logo)
        && request.resource.data.kind in ['food', 'pc', 'ai', 'nuclear']
        && request.resource.data.products == []
        && request.resource.data.open == 0
        && request.resource.data.staff == 0
        && request.resource.data.at == request.time
        && getAfter(walletPath(request.auth.uid)).data.op.kind == 'found'
        && getAfter(walletPath(request.auth.uid)).data.op.cid == cid
        && getAfter(walletPath(request.auth.uid)).data.bal == get(walletPath(request.auth.uid)).data.bal - 10;
      allow update: if signedIn() && (
        // 사장: 채용 공고(모집 인원을 정한 수로 맞추기)나 업종 바꾸기만 해요. 예전 회사는 owner 칸이 없어서 문서 번호가 사장이에요
        (resource.data.get('owner', cid) == request.auth.uid && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open'])
            && request.resource.data.open is int
            && request.resource.data.open >= 0)
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind'])
            && request.resource.data.kind in ['food', 'pc', 'ai', 'nuclear']
            && request.resource.data.kind != resource.data.get('kind', 'food'))
        ))
        ||
        // 입사: 같은 묶음에서 내 일자리 기록이 생기고, 모집이 1명 줄고 직원이 1명 늘어요
        (resource.data.get('owner', cid) != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open', 'staff'])
          && resource.data.get('open', 0) >= 1
          && request.resource.data.open == resource.data.get('open', 0) - 1
          && request.resource.data.staff == resource.data.get('staff', 0) + 1
          && getAfter(jobPath(request.auth.uid)).data.cid == cid)
        ||
        // 퇴사: 같은 묶음에서 내 일자리 기록이 지워지고, 직원이 1명 줄어요
        (resource.data.get('owner', cid) != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staff'])
          && request.resource.data.staff == resource.data.get('staff', 0) - 1
          && request.resource.data.staff >= 0
          && get(jobPath(request.auth.uid)).data.cid == cid
          && !existsAfter(jobPath(request.auth.uid)))
      );

      // 연구실·발전소 숫자 (사장과 그 회사 직원만 바꿔요). 금고(cash, 센트)는 사장만 넣고 빼고, 발전 비용과 사고팔 때 내고 받아요.
      //   원자력 발전: 핵연료 성능(nperf)이 높을수록 적은 돈으로(1초 = 1 토큰), 빨리, 한 번에 많이(최대 성능 × 10) 만들어요. 받기는 회사 사람 누구나 해요.
      //   컴퓨터: 처리 용량(cap)·처리 속도(spd)·전기값(pow)을 올리고, 출시하면 그때 숫자를 rel에 남겨요.
      //   인공지능: 데이터(aiData)를 쌓고, 출시하면 점수(aiScore)를 남겨요. 숫자는 줄지 않아요. 출시 값은 사장만 바꿔요.
      //   사고팔기: 전기(e)는 원자력 발전 회사가 팔고 인공지능 회사가 사요. 컴퓨터(p)도 같아요. 인공지능 사용 시간(h)은 누구나 살 수 있어요.
      //     파는 쪽과 사는 쪽이 같은 묶음에서 함께 바뀔 때만 돼요 (기록 시각이 이 쓰기의 서버 시각이어야 해요). 단가(price)는 파는 회사 사장이 정해요.
      match /lab/{ld} {
        function labOk(d) {
          return d.keys().hasOnly(['nperf', 'elec', 'gen', 'cap', 'spd', 'pow', 'rel', 'aiData', 'aiScore', 'cash', 'price', 'sold', 'bought', 'pcN', 'pcM', 'aiH', 'trn', 'aiDev', 'food', 'fperf', 'plv', 'prod'])
            && d.nperf is int && d.nperf >= 100 && d.nperf <= 100000
            && d.elec is int && d.elec >= 0 && d.elec <= 1000000000
            && (d.get('gen', null) == null || (d.gen.keys().hasOnly(['amt', 'secs', 'started'])
                && d.gen.amt is int && d.gen.amt >= 1 && d.gen.amt <= 100000
                && d.gen.secs is int && d.gen.secs >= 1 && d.gen.started is timestamp))
            && d.cap is int && d.cap >= 0 && d.cap <= 1000000
            && d.spd is int && d.spd >= 0 && d.spd <= 1000000
            && d.pow is int && d.pow >= 0 && d.pow <= 1000000
            && (d.get('rel', null) == null || (d.rel.keys().hasOnly(['cap', 'spd', 'pow'])
                && d.rel.cap is int && d.rel.cap >= 0 && d.rel.cap <= d.cap
                && d.rel.spd is int && d.rel.spd >= 0 && d.rel.spd <= d.spd
                && d.rel.pow is int && d.rel.pow >= 0 && d.rel.pow <= d.pow))
            && d.aiData is int && d.aiData >= 0 && d.aiData <= 1000000000
            && d.aiScore is int && d.aiScore >= -1 && d.get('aiDev', 0) is int && d.get('aiDev', 0) >= 0 && d.get('aiDev', 0) <= 1000000000
            && (d.get('trn', null) == null || (d.trn.keys().hasOnly(['d', 'secs', 'score', 'started'])
                && d.trn.d is int && d.trn.d >= 1 && d.trn.secs is int && d.trn.secs >= 1
                && d.trn.score is int && d.trn.score >= 0 && d.trn.started is timestamp))
            && d.cash is int && d.cash >= 0 && d.cash <= 100000000000
            && d.price is int && d.price >= 0 && d.price <= 100000000
            && (d.get('sold', null) == null || (d.sold.keys().hasOnly(['to', 'kind', 'n', 'total', 'at', 'cap', 'spd', 'pow'])
                && d.sold.to is string && d.sold.kind in ['e', 'p', 'h'] && d.sold.n is int && d.sold.n >= 1
                && d.sold.total is int && d.sold.total >= 0 && d.sold.at is timestamp))
            && (d.get('bought', null) == null || (d.bought.keys().hasOnly(['from', 'kind', 'n', 'total', 'at', 'cap', 'spd', 'pow'])
                && d.bought.from is string && d.bought.kind in ['e', 'p', 'h'] && d.bought.n is int && d.bought.n >= 1
                && d.bought.total is int && d.bought.total >= 0 && d.bought.at is timestamp))
            && d.get('pcN', 0) is int && d.get('pcN', 0) >= 0 && d.get('pcN', 0) <= 1000000
            && (d.get('pcM', null) == null || (d.pcM.keys().hasOnly(['cap', 'spd', 'pow'])
                && d.pcM.cap is int && d.pcM.spd is int && d.pcM.pow is int))
            && d.get('aiH', 0) is int && d.get('aiH', 0) >= 0 && d.get('aiH', 0) <= 1000000000
            && d.get('fperf', 100) is int && d.get('fperf', 100) >= 100 && d.get('fperf', 100) <= 1000000
        }
        // 평소 쓰기(회사 사람)는 사고팔기 기록·학습 기록을 다시 검사하지 않아요. 그 칸은 사고파는 묶음과 학습 조건에서 따로 확인해요
        function labCore(d) {
          return d.keys().hasOnly(['nperf', 'elec', 'gen', 'cap', 'spd', 'pow', 'rel', 'aiData', 'aiScore', 'cash', 'price', 'sold', 'bought', 'pcN', 'pcM', 'aiH', 'trn', 'aiDev', 'food', 'fperf', 'plv', 'prod'])
            && d.nperf is int && d.nperf >= 100 && d.nperf <= 100000
            && d.elec is int && d.elec >= 0 && d.elec <= 1000000000
            && (d.get('gen', null) == null || (d.gen.keys().hasOnly(['amt', 'secs', 'started'])
                && d.gen.amt is int && d.gen.amt >= 1 && d.gen.amt <= 100000
                && d.gen.secs is int && d.gen.secs >= 1 && d.gen.started is timestamp))
            && d.cap is int && d.cap >= 0 && d.cap <= 1000000
            && d.spd is int && d.spd >= 0 && d.spd <= 1000000
            && d.pow is int && d.pow >= 0 && d.pow <= 1000000
            && (d.get('rel', null) == null || (d.rel.keys().hasOnly(['cap', 'spd', 'pow'])
                && d.rel.cap is int && d.rel.cap >= 0 && d.rel.cap <= d.cap
                && d.rel.spd is int && d.rel.spd >= 0 && d.rel.spd <= d.spd
                && d.rel.pow is int && d.rel.pow >= 0 && d.rel.pow <= d.pow))
            && d.aiData is int && d.aiData >= 0 && d.aiData <= 1000000000
            && d.aiScore is int && d.aiScore >= -1
            && d.get('aiDev', 0) is int && d.get('aiDev', 0) >= 0 && d.get('aiDev', 0) <= 1000000000
            && d.cash is int && d.cash >= 0 && d.cash <= 100000000000
            && d.price is int && d.price >= 0 && d.price <= 100000000
            && d.get('fperf', 100) is int && d.get('fperf', 100) >= 100 && d.get('fperf', 100) <= 1000000
        }
        // 일하기 묶음: 같은 묶음에서 내 기록(vitals)이 바뀌었고, 바뀐 일 수(wk)만큼 성능이 올라갈 때만 돼요
        function workedNow() {
          let vp = /databases/$(database)/documents/vitals/$(request.auth.uid);
          return getAfter(vp).data.get('wk', 0) == request.resource.data.get('fperf', 100) - resource.data.get('fperf', 100)
            && getAfter(vp).data.at != get(vp).data.at;
        }
        function labWho() {
          return signedIn() && (labOwner() || (exists(jobPath(request.auth.uid)) && get(jobPath(request.auth.uid)).data.cid == cid));
        }
        function labOwner() {
          return get(companyPath(cid)).data.get('owner', cid) == request.auth.uid;
        }
        function labPathOf(c) { return /databases/$(database)/documents/companies/$(c)/lab/main; }
        // 발전 시작: 걸리는 시간은 핵연료 성능으로 정해요 (올림: 전기 × 100 ÷ 성능). 한 번에 최대 성능 × 10까지예요.
        //   시작 시각은 이 쓰기의 서버 시각이어야 해요
        function genStarts(d) {
          return d.get('gen', null) != null
            && d.gen.secs == (d.gen.amt * 100 + d.nperf - 1) / d.nperf
            && d.gen.amt <= d.nperf * 10
            && d.gen.started == request.time;
        }
        // 창고 받기: 발전 시간이 다 지나야 해요
        function genDone(o) {
          return o.get('gen', null) != null
            && request.time >= o.gen.started + duration.value(o.gen.secs, 's');
        }
        // 금고 넣기: 사장이 같은 묶음에서 지갑 토큰을 그만큼 뺀 경우만 (금고는 센트: 토큰 × 100)
        function depositOk(before) {
          return labOwner()
            && getAfter(walletPath(request.auth.uid)).data.op.kind == 'deposit'
            && getAfter(walletPath(request.auth.uid)).data.op.cid == cid
            && get(walletPath(request.auth.uid)).data.bal - getAfter(walletPath(request.auth.uid)).data.bal == getAfter(walletPath(request.auth.uid)).data.op.amt
            && request.resource.data.cash == before + getAfter(walletPath(request.auth.uid)).data.op.amt * 100;
        }
        // 금고 빼기: 사장이 같은 묶음에서 지갑에 토큰을 그만큼 더한 경우만
        function withdrawOk(before) {
          return labOwner()
            && getAfter(walletPath(request.auth.uid)).data.op.kind == 'withdraw'
            && getAfter(walletPath(request.auth.uid)).data.op.cid == cid
            && getAfter(walletPath(request.auth.uid)).data.bal - get(walletPath(request.auth.uid)).data.bal == getAfter(walletPath(request.auth.uid)).data.op.amt
            && request.resource.data.cash == before - getAfter(walletPath(request.auth.uid)).data.op.amt * 100;
        }
        // ----- 식품 공장 (사장만). 공장 한 대는 한 개를 60초에 만들어요. 대수(plv)가 많으면 60초에 대수만큼 만들어요.
        // 돌리기: 개수(left)를 정해 두고 시작해요. 재료값과 재고는 만든 만큼 같은 묶음에서 바뀌어요 (정산할 때).
        // 정산: 지금까지 만든 개수 u는 서버 시각으로 계산한 최대치 이하면 돼요 (덜 받는 건 괜찮아요).
        // 공장 추가: 500토큰(50000센트)을 금고에서 내요. 돌고 있으면 못 해요.
        function prodPath(pid) { return /databases/$(database)/documents/companies/$(cid)/products/$(pid); }
        function factoryStart() {
          return resource.data.get('prod', null) == null
            && request.resource.data.get('prod', null) != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prod'])
            && labOwner()
            && request.resource.data.prod.keys().hasOnly(['pid', 'left', 'at'])
            && request.resource.data.prod.left is int && request.resource.data.prod.left >= 1 && request.resource.data.prod.left <= 100000
            && request.resource.data.prod.at == request.time
            && get(prodPath(request.resource.data.prod.pid)).data.get('owner', '') == request.auth.uid
            && get(prodPath(request.resource.data.prod.pid)).data.get('active', false) == true;
        }
        function factorySettle() {
          let old = resource.data.get('prod', {'left': 0, 'at': request.time, 'pid': ''});
          let plv = resource.data.get('plv', 1);
          let np = request.resource.data.get('prod', {'left': 0});
          let u = old.left - np.left;
          return resource.data.get('prod', null) != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cash', 'prod'])
            && u >= 1 && u <= old.left
            && u * 60000 <= (request.time.toMillis() - old.at.toMillis()) * plv
            && request.resource.data.cash == resource.data.get('cash', 0) - u * get(prodPath(old.pid)).data.get('costCents', 0)
            && request.resource.data.cash >= 0
            && getAfter(prodPath(old.pid)).data.stock == get(prodPath(old.pid)).data.get('stock', 0) + u
            && ((request.resource.data.get('prod', null) == null && u == old.left)
              || (request.resource.data.get('prod', null) != null
                && request.resource.data.prod.pid == old.pid
                && request.resource.data.prod.left >= 1
                && request.resource.data.prod.at.toMillis() == old.at.toMillis() + (u * 60000) / plv));
        }
        function factoryBuy() {
          return resource.data.get('prod', null) == null
            && request.resource.data.get('prod', null) == null
            && labOwner()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cash', 'plv'])
            && request.resource.data.plv == resource.data.get('plv', 1) + 1
            && request.resource.data.plv <= 1000
            && request.resource.data.cash == resource.data.get('cash', 0) - 50000
            && request.resource.data.cash >= 0;
        }
        // 사고팔기 기록(sold·bought)과 물건 숫자(pcN·pcM·aiH)는 사고파는 묶음에서만 바뀌어요
        // 학습 시작 (사장만): 가진 컴퓨터(pcM)로 학습해요. 배치 수 = 올림(데이터 ÷ 처리 용량), 전기 = 배치 수 × 전기값,
        //   걸리는 시간 = 올림(배치 수 ÷ 처리 속도), 개발 점수 = 데이터 × (용량 + 속도) ÷ 100 (내림). 데이터는 그대로예요
        function trainStartsOk(o) {
          return request.resource.data.get('trn', null) != null
            && o.get('trn', null) == null
            && labOwner()
            && request.resource.data.get('pcN', 0) >= 1
            && request.resource.data.get('pcM', null) != null
            && request.resource.data.trn.keys().hasOnly(['d', 'secs', 'score', 'started'])
            && request.resource.data.trn.d >= 1
            && request.resource.data.trn.d <= request.resource.data.aiData
            && request.resource.data.trn.started == request.time
            && request.resource.data.trn.score == (request.resource.data.trn.d * (request.resource.data.pcM.cap + request.resource.data.pcM.spd)) / 100
            && request.resource.data.trn.secs == ((((request.resource.data.trn.d + request.resource.data.pcM.cap - 1) / request.resource.data.pcM.cap) + request.resource.data.pcM.spd - 1) / request.resource.data.pcM.spd)
            && request.resource.data.elec == o.elec - (((request.resource.data.trn.d + request.resource.data.pcM.cap - 1) / request.resource.data.pcM.cap) * request.resource.data.pcM.pow);
        }
        // 학습 결과 받기: 걸린 시간이 지나야 해요
        function trainDone(o) {
          return o.get('trn', null) != null
            && request.time >= o.trn.started + duration.value(o.trn.secs, 's');
        }
        // 학습 기록(trn)과 개발 점수(aiDev)는 학습 묶음에서만 바뀌어요
        function trainSame() {
          return request.resource.data.get('trn', null) == resource.data.get('trn', null)
            && request.resource.data.get('aiDev', 0) == resource.data.get('aiDev', 0);
        }
        function marketSame() {
          return request.resource.data.get('food', null) == resource.data.get('food', null)
            && request.resource.data.get('sold', null) == resource.data.get('sold', null)
            && request.resource.data.get('bought', null) == resource.data.get('bought', null)
            && request.resource.data.get('pcN', 0) == resource.data.get('pcN', 0)
            && request.resource.data.get('pcM', null) == resource.data.get('pcM', null)
            && request.resource.data.get('aiH', 0) == resource.data.get('aiH', 0)
            && request.resource.data.get('plv', 1) == resource.data.get('plv', 1)
            && request.resource.data.get('prod', null) == resource.data.get('prod', null);
        }
        // 음식은 금고를 바로 늘리지 않아요. 만든 음식은 상품 재고(products)가 늘고, 상점에서 팔릴 때 금고가 늘어요 (shopIn)
        // 상점 판매 (파는 회사 금고): 사는 사람의 지갑 쓰기가 같은 묶음에 있고, 그 토큰(× 100 센트)만큼만 금고가 늘어요. 다른 칸은 그대로예요
        function shopIn() {
          // 칸 확인을 먼저 해요 (다른 칸이 바뀌는 평소 쓰기는 여기서 바로 넘어가요. 규칙 계산 횟수를 아껴요)
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cash'])
            && signedIn()
            && getAfter(walletPath(request.auth.uid)).data.wt == request.time
            && getAfter(walletPath(request.auth.uid)).data.op.kind == 'shop'
            && getAfter(walletPath(request.auth.uid)).data.op.cid == cid
            && request.resource.data.cash == resource.data.get('cash', 0) + getAfter(walletPath(request.auth.uid)).data.op.tokens * 100;
        }
        // 파는 쪽: 사는 회사 사장이 같은 묶음에서 사는 쪽 기록(bought)을 쓸 때만, 돈이 들어오고 재고가 줄어요
        function saleIn() {
          return signedIn()
            && request.resource.data.get('sold', null) != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cash', 'elec', 'sold'])
            && request.resource.data.cash >= 0
            && request.resource.data.elec >= 0
            && request.resource.data.sold.n >= 1
            && request.resource.data.sold.total >= 0
            && request.resource.data.sold.to is string
            && get(companyPath(request.resource.data.sold.to)).data.get('owner', request.resource.data.sold.to) == request.auth.uid
            && request.resource.data.sold.at == request.time
            && getAfter(labPathOf(request.resource.data.sold.to)).data.bought.at == request.time
            && getAfter(labPathOf(request.resource.data.sold.to)).data.bought.from == cid
            && getAfter(labPathOf(request.resource.data.sold.to)).data.bought.kind == request.resource.data.sold.kind
            && getAfter(labPathOf(request.resource.data.sold.to)).data.bought.n == request.resource.data.sold.n
            && getAfter(labPathOf(request.resource.data.sold.to)).data.bought.total == request.resource.data.sold.total
            && request.resource.data.sold.total == request.resource.data.sold.n * resource.data.get('price', 0)
            && request.resource.data.cash == resource.data.get('cash', 0) + request.resource.data.sold.total
            && ((request.resource.data.sold.kind == 'e'
                  && get(companyPath(cid)).data.kind == 'nuclear'
                  && request.resource.data.elec == resource.data.elec - request.resource.data.sold.n)
                || (request.resource.data.sold.kind == 'p'
                  && get(companyPath(cid)).data.kind == 'pc'
                  && request.resource.data.elec == resource.data.elec
                  && resource.data.get('rel', null) == {'cap': request.resource.data.sold.cap, 'spd': request.resource.data.sold.spd, 'pow': request.resource.data.sold.pow})
                || (request.resource.data.sold.kind == 'h'
                  && get(companyPath(cid)).data.kind == 'ai'
                  && request.resource.data.elec == resource.data.elec
                  && resource.data.get('aiScore', -1) >= 0));
        }
        // 사는 쪽: 파는 회사 기록(sold)이 같은 묶음에서 쓰일 때만, 돈이 나가고 물건이 들어와요
        function saleOut() {
          return signedIn()
            && request.resource.data.get('bought', null) != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cash', 'elec', 'pcN', 'pcM', 'aiH', 'bought'])
            && request.resource.data.cash >= 0
            && request.resource.data.elec >= 0
            && request.resource.data.bought.n >= 1
            && request.resource.data.bought.total >= 0
            && labOwner()
            && request.resource.data.bought.from is string
            && request.resource.data.bought.at == request.time
            && getAfter(labPathOf(request.resource.data.bought.from)).data.sold.to == cid
            && getAfter(labPathOf(request.resource.data.bought.from)).data.sold.at == request.time
            && getAfter(labPathOf(request.resource.data.bought.from)).data.sold.kind == request.resource.data.bought.kind
            && getAfter(labPathOf(request.resource.data.bought.from)).data.sold.n == request.resource.data.bought.n
            && getAfter(labPathOf(request.resource.data.bought.from)).data.sold.total == request.resource.data.bought.total
            && request.resource.data.cash == resource.data.get('cash', 0) - request.resource.data.bought.total
            && ((request.resource.data.bought.kind == 'e'
                  && get(companyPath(cid)).data.kind == 'ai'
                  && request.resource.data.elec == resource.data.elec + request.resource.data.bought.n
                  && request.resource.data.get('pcN', 0) == resource.data.get('pcN', 0)
                  && request.resource.data.get('pcM', null) == resource.data.get('pcM', null)
                  && request.resource.data.get('aiH', 0) == resource.data.get('aiH', 0))
                || (request.resource.data.bought.kind == 'p'
                  && get(companyPath(cid)).data.kind == 'ai'
                  && request.resource.data.elec == resource.data.elec
                  && request.resource.data.get('aiH', 0) == resource.data.get('aiH', 0)
                  && request.resource.data.pcM == {'cap': request.resource.data.bought.cap, 'spd': request.resource.data.bought.spd, 'pow': request.resource.data.bought.pow}
                  && ((resource.data.get('pcM', null) == request.resource.data.pcM && request.resource.data.pcN == resource.data.get('pcN', 0) + request.resource.data.bought.n)
                      || (resource.data.get('pcM', null) != request.resource.data.pcM && request.resource.data.pcN == request.resource.data.bought.n)))
                || (request.resource.data.bought.kind == 'h'
                  && request.resource.data.elec == resource.data.elec
                  && request.resource.data.get('pcN', 0) == resource.data.get('pcN', 0)
                  && request.resource.data.get('pcM', null) == resource.data.get('pcM', null)
                  && request.resource.data.aiH == resource.data.get('aiH', 0) + request.resource.data.bought.n));
        }
        allow get: if signedIn();
        allow create: if labWho() && labOk(request.resource.data)
          && request.resource.data.elec == 0
          && request.resource.data.get('gen', null) == null
          && (request.resource.data.cash == 0 || depositOk(0))
          && (request.resource.data.price == 0 || labOwner())
          && (request.resource.data.get('rel', null) == null && request.resource.data.aiScore == -1 || labOwner())
          && request.resource.data.get('sold', null) == null
          && request.resource.data.get('bought', null) == null
          && request.resource.data.get('pcN', 0) == 0
          && request.resource.data.get('pcM', null) == null
          && request.resource.data.get('aiH', 0) == 0
          && request.resource.data.get('trn', null) == null
          && request.resource.data.get('prod', null) == null
          && request.resource.data.get('plv', 1) == 1
          && request.resource.data.get('aiDev', 0) == 0;
        // 사고파는 쪽을 먼저 봐요 (규칙 호출 횟수 한도 안에서 판단하도록). 그다음이 회사 사람의 일반 쓰기예요
        allow update: if saleIn()
          || saleOut()
          || shopIn()
          || ((request.resource.data.get('prod', null) != resource.data.get('prod', null) || request.resource.data.get('plv', 1) != resource.data.get('plv', 1))
            && labOwner() && (factoryStart() || factorySettle() || factoryBuy()))
          || (labWho() && labCore(request.resource.data) && marketSame()
            && request.resource.data.nperf >= resource.data.nperf
            && request.resource.data.cap >= resource.data.get('cap', 0)
            && request.resource.data.spd >= resource.data.get('spd', 0)
            && request.resource.data.pow >= resource.data.get('pow', 0)
            && request.resource.data.aiData >= resource.data.aiData
            && request.resource.data.get('fperf', 100) >= resource.data.get('fperf', 100)
            && (request.resource.data.get('fperf', 100) == resource.data.get('fperf', 100) || workedNow())
            && (
              // 금고만 넣고 빼는 쓰기 (발전·학습 기록은 그대로): 평소 쓰기는 여기서 바로 확인해요
              (request.resource.data.get('gen', null) == resource.data.get('gen', null)
                && request.resource.data.elec == resource.data.elec
                && trainSame()
                && (request.resource.data.cash == resource.data.get('cash', 0)
                    || depositOk(resource.data.get('cash', 0))
                    || withdrawOk(resource.data.get('cash', 0))))
              // 발전 시작 (사장만): 아직 발전 중이 아닐 때, 비용(걸린 초 × 1 토큰)이 금고에서 나가고 창고는 그대로예요
              || (resource.data.get('gen', null) == null && genStarts(request.resource.data) && labOwner()
                && request.resource.data.elec == resource.data.elec
                && request.resource.data.cash == resource.data.get('cash', 0) - request.resource.data.gen.secs * 100
                && trainSame())
              // 창고 받기 (회사 사람 누구나): 발전이 끝나면 발전량만큼 창고가 늘고, 발전 기록은 지워져요. 돈은 그대로예요
              || (genDone(resource.data) && request.resource.data.get('gen', null) == null
                && request.resource.data.elec == resource.data.elec + resource.data.gen.amt
                && request.resource.data.cash == resource.data.get('cash', 0)
                && trainSame())
              // 학습 시작 (사장만): 컴퓨터로 학습하고, 전기가 창고에서 나가요. 데이터와 금고는 그대로예요
              || (trainStartsOk(resource.data)
                && request.resource.data.get('gen', null) == resource.data.get('gen', null)
                && request.resource.data.cash == resource.data.get('cash', 0)
                && request.resource.data.get('aiDev', 0) == resource.data.get('aiDev', 0))
              // 학습 결과 받기 (회사 사람 누구나): 걸린 시간이 지나면 개발 점수가 정해지고, 학습 기록은 지워져요
              || (trainDone(resource.data) && request.resource.data.get('trn', null) == null
                && request.resource.data.get('aiDev', 0) == resource.data.trn.score
                && request.resource.data.elec == resource.data.elec
                && request.resource.data.cash == resource.data.get('cash', 0)
                && request.resource.data.get('gen', null) == resource.data.get('gen', null))
            )
            && (request.resource.data.price == resource.data.get('price', 0) || labOwner())
            && (request.resource.data.get('rel', null) == resource.data.get('rel', null)
                || (labOwner() && request.resource.data.get('rel', null) != null
                    && request.resource.data.rel.cap == request.resource.data.cap
                    && request.resource.data.rel.spd == request.resource.data.spd
                    && request.resource.data.rel.pow == request.resource.data.pow))
            // 출시: 사장만, 지금의 개발 점수를 그대로 적어요 (1 이상)
            && (request.resource.data.aiScore == resource.data.aiScore
                || (labOwner() && request.resource.data.get('aiDev', 0) >= 1 && request.resource.data.aiScore == request.resource.data.get('aiDev', 0))))
          || saleIn()
          || saleOut()
          || factoryStart();
        allow delete: if false;
      }

      // 팔 상품: 한 상품이 한 문서예요. 회사 사장만 만들고 고쳐요. 만들 때 종류·모양·색·원가·가격을 모두 검사해요 (원가·가격은 센트 정수예요: 50 = 0.5 토큰).
      // 나중에는 이름 바꾸기, 판매 멈춤·다시 시작(paused), 판매 종료(active를 false로)만 할 수 있어요. 판매를 끝낸 상품은 더 못 바꿔요
      match /products/{pid} {
        allow get: if signedIn();
        allow list: if signedIn() && request.query.limit <= 50;
        allow create: if signedIn()
          && get(companyPath(cid)).data.get('owner', cid) == request.auth.uid
          && request.resource.data.keys().hasOnly(['owner', 'cat', 'group', 'item', 'name', 'shape', 'color', 'cap', 'capColor', 'content', 'costCents', 'priceCents', 'paused', 'active', 'at'])
          && request.resource.data.keys().hasAll(['owner', 'cat', 'group', 'item', 'name', 'shape', 'color', 'costCents', 'priceCents', 'paused', 'active', 'at'])
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.cat == 'food'
          && request.resource.data.group in ['water', 'snack', 'meal', 'energy']
          && request.resource.data.item in ['water', 'jelly', 'chips', 'bread', 'lunchbox', 'meat', 'bar', 'drink', 'coffee']
          && (
            (request.resource.data.group == 'water' && request.resource.data.item == 'water')
            || (request.resource.data.group == 'snack' && request.resource.data.item in ['jelly', 'chips', 'bread'])
            || (request.resource.data.group == 'meal' && request.resource.data.item in ['lunchbox', 'meat'])
            || (request.resource.data.group == 'energy' && request.resource.data.item in ['bar', 'drink', 'coffee'])
          )
          && request.resource.data.name is string
          && request.resource.data.name.matches('^[^<>]{1,30}$')
          && request.resource.data.shape is int && request.resource.data.shape >= 0 && request.resource.data.shape <= 49
          && request.resource.data.color is int && request.resource.data.color >= -1 && request.resource.data.color <= 49
          && (!('cap' in request.resource.data) || (request.resource.data.item == 'water' && request.resource.data.cap is int && request.resource.data.cap >= 0 && request.resource.data.cap <= 49))
          && (!('capColor' in request.resource.data) || (request.resource.data.item == 'water' && request.resource.data.capColor is int && request.resource.data.capColor >= -1 && request.resource.data.capColor <= 49))
          && (!('content' in request.resource.data) || (request.resource.data.content is int && request.resource.data.content >= 0 && request.resource.data.content <= 5))
          && request.resource.data.costCents is int && request.resource.data.costCents >= 1 && request.resource.data.costCents <= 999999
          && request.resource.data.priceCents is int && request.resource.data.priceCents >= 1 && request.resource.data.priceCents <= 99999999
          && request.resource.data.paused == false
          && request.resource.data.active == true
          && request.resource.data.at == request.time;
        allow update: if signedIn()
          && resource.data.owner == request.auth.uid
          && resource.data.active == true
          && (
            // 판매 종료: active만 false로 (되돌릴 수 없어요)
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
              && request.resource.data.active == false)
            ||
            // 판매 멈춤·다시 시작: paused만 실제로 바꿔요 (예전 상품에는 paused가 없어서 false로 봐요)
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paused'])
              && request.resource.data.paused is bool
              && request.resource.data.paused != resource.data.get('paused', false))
            ||
            // 이름 바꾸기: name만 실제로 바꿔요. 만들 때와 같은 글자 규칙
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
              && request.resource.data.name is string
              && request.resource.data.name != resource.data.name
              && request.resource.data.name.matches('^[^<>]{1,30}$'))
          );
        // 음식 생산 (사장만): 재고가 늘면, 같은 묶음에서 공장 정산이 그만큼 금고를 줄여야 해요 (재료값 = 개수 × 원가)
        function producing() {
          return get(companyPath(cid)).data.get('owner', cid) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
            && request.resource.data.stock > resource.data.get('stock', 0)
            && getAfter(/databases/$(database)/documents/companies/$(cid)/lab/main).data.cash
              == get(/databases/$(database)/documents/companies/$(cid)/lab/main).data.get('cash', 0) - (request.resource.data.stock - resource.data.get('stock', 0)) * resource.data.get('costCents', 0);
        }
        // 상점에서 사기: 재고만 줄어요. 같은 묶음에서 사는 사람 지갑이 값(토큰, 올림)을 내고, 파는 회사 금고가 그만큼 늘어야 해요
        function shopping() {
          return resource.data.get('active', false) == true
            && resource.data.get('paused', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
            && request.resource.data.stock >= 0
            && getAfter(walletPath(request.auth.uid)).data.op.kind == 'shop'
            && getAfter(walletPath(request.auth.uid)).data.op.cid == cid
            && getAfter(walletPath(request.auth.uid)).data.op.pid == pid
            && getAfter(walletPath(request.auth.uid)).data.wt == request.time
            && request.resource.data.stock == resource.data.get('stock', 0) - getAfter(walletPath(request.auth.uid)).data.op.n
            && getAfter(walletPath(request.auth.uid)).data.op.tokens * 100 >= getAfter(walletPath(request.auth.uid)).data.op.n * resource.data.priceCents
            && getAfter(walletPath(request.auth.uid)).data.op.tokens * 100 < getAfter(walletPath(request.auth.uid)).data.op.n * resource.data.priceCents + 100;
        }
        allow update: if signedIn() && producing();
        allow update: if signedIn() && shopping();
        // 꺼내 먹기 (사장만): 창고에서 한 개만 줄어요. 먹기 기록(vitals)은 같은 묶음에서 써야 하고, 그쪽에서 이 줄어듦을 확인해요
        allow update: if signedIn() && resource.data.get('owner', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && request.resource.data.stock < resource.data.get('stock', 0)
          && request.resource.data.stock >= 0;
        allow delete: if false;
      }
    }

    // ----- 상점: 재고가 있는 음식 상품을 여러 회사에서 한꺼번에 찾아요 (읽기만 해요. 한 번에 50개까지) -----
    match /{path=**}/products/{pid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
    }

    // ----- 일자리: 내가 다니는 회사 한 곳이에요. 만들거나 지우는 것은 회사 인원이 같은 묶음에서 바뀔 때만. 내 회사에는 지원할 수 없어요 -----
    match /jobs/{uid} {
      allow get: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['cid', 'kind', 'at'])
        && request.resource.data.cid is string
        && request.resource.data.kind in ['food', 'pc', 'ai', 'nuclear']
        && request.resource.data.at == request.time
        && get(companyPath(request.resource.data.cid)).data.get('owner', request.resource.data.cid) != uid
        && getAfter(companyPath(request.resource.data.cid)).data.get('kind', 'food') == request.resource.data.kind
        && getAfter(companyPath(request.resource.data.cid)).data.get('staff', 0) == get(companyPath(request.resource.data.cid)).data.get('staff', 0) + 1;
      allow delete: if isMe(uid)
        && getAfter(companyPath(resource.data.cid)).data.get('staff', 0) == get(companyPath(resource.data.cid)).data.get('staff', 0) - 1;
      allow update: if false;
    }

    // ----- 상태(배고픔·목마름·에너지): 값은 시간이 지나면 닳기만 해요. 쓰러졌을 때만 기록하고, 그때 다 10%로 돌아오며 1·2·3시간… 쉬어요 -----
    match /vitals/{uid} {
      allow delete: if isOwner() && adminDelOk();
      allow get: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['h', 't', 'e', 'at', 'deaths'])
        && request.resource.data.h == 100 && request.resource.data.t == 100 && request.resource.data.e == 100
        && request.resource.data.deaths == 0
        && request.resource.data.at is int
        && request.resource.data.at >= request.time.toMillis() - 120000
        && request.resource.data.at <= request.time.toMillis() + 120000;
      // 닳는 값 (서버 시각 기준): 에너지가 0이 되면 배고픔·목마름이 두 배로 닳아요.
      //   에너지가 0이 된 뒤의 시간은 두 배로 세요 (T가 에너지 0이 되기까지 시간 S를 넘으면, 넘은 만큼 한 번 더 세요)
      function effT() {
        let T = request.time.toMillis() - resource.data.at;
        let S = resource.data.e * 25920000.0;
        return T + (T > S ? T - S : 0);
      }
      function decE(v) { return v - (request.time.toMillis() - resource.data.at) * 100.0 / 2592000000.0; }
      // 먹기: 내 인벤토리에서 한 개를 먹어요. 같은 묶음에서 그 음식 칸(n)이 한 개 줄어야 해요 (먹은 음식은 eat에 적어요)
      //   기본은 20이에요 (성능 100). 회사 식품 성능(fperf)이 높을수록 많이 올라가요: 올라가는 양 = 20 × 성능 ÷ 100.
      //   물은 목마름, 간식·식사는 배고픔, 에너지 식품은 에너지가 올라가요. 100을 넘지 않아요
      function itemPath() { return /databases/$(database)/documents/inventory/$(request.auth.uid)/items/$(request.resource.data.eat.cid + '_' + request.resource.data.eat.pid); }
      function nearTo(v, x) { return v <= 100 && v <= x + 0.5 && (v >= x - 0.5 || (x > 100 && v >= 99.5)); }
      // 회사 식품 성능 (없으면 100)
      function perfOf(cid) {
        return exists(/databases/$(database)/documents/companies/$(cid)/lab/main)
          ? get(/databases/$(database)/documents/companies/$(cid)/lab/main).data.get('fperf', 100) : 100;
      }
      function eatOk() {
        let eT = effT();
        let grp = get(itemPath()).data.group;
        let q = 20.0 * perfOf(request.resource.data.eat.cid) / 100;
        let gain = {'water': {'h': 0, 't': q, 'e': 0}, 'snack': {'h': q, 't': 0, 'e': 0}, 'meal': {'h': q, 't': 0, 'e': 0}, 'energy': {'h': 0, 't': 0, 'e': q}}[grp];
        return request.resource.data.keys().hasOnly(['h', 't', 'e', 'at', 'deaths', 'eat', 'wk'])
          && request.resource.data.get('wk', 0) == 0
          && request.resource.data.deaths == resource.data.deaths
          && request.resource.data.eat is map
          && request.resource.data.eat.keys().hasOnly(['cid', 'pid'])
          && request.resource.data.eat.cid is string
          && request.resource.data.eat.pid is string
          && request.time.toMillis() >= resource.data.at
          && request.resource.data.at is int
          && request.resource.data.at >= request.time.toMillis() - 120000
          && request.resource.data.at <= request.time.toMillis() + 120000
          && get(itemPath()).data.get('n', 0) >= 1
          && getAfter(itemPath()).data.get('n', 0) == get(itemPath()).data.get('n', 0) - 1
          && nearTo(request.resource.data.h, resource.data.h - eT * 100.0 / 86400000.0 + gain.h)
          && nearTo(request.resource.data.t, resource.data.t - eT * 100.0 / 64800000.0 + gain.t)
          && nearTo(request.resource.data.e, (decE(resource.data.e) > 0 ? decE(resource.data.e) : 0) + gain.e);
      }
      // 일하기 (직원·사장): 에너지가 일한 만큼(wk) 내려가요. 같은 묶음에서 회사 식품 성능이 wk만큼 올라가야 해요 (연구실 규칙이 확인해요)
      function workOk() {
        let eT = effT();
        let hNow = resource.data.h - eT * 100.0 / 86400000.0;
        let tNow = resource.data.t - eT * 100.0 / 64800000.0;
        return request.resource.data.keys().hasOnly(['h', 't', 'e', 'at', 'deaths', 'eat', 'wk'])
          && request.resource.data.deaths == resource.data.deaths
          && request.resource.data.get('eat', null) == resource.data.get('eat', null)
          && request.resource.data.wk is int && request.resource.data.wk >= 1 && request.resource.data.wk <= 10
          && request.time.toMillis() >= resource.data.at
          && request.resource.data.at is int
          && request.resource.data.at >= request.time.toMillis() - 120000
          && request.resource.data.at <= request.time.toMillis() + 120000
          && hNow > 0 && tNow > 0
          && decE(resource.data.e) >= request.resource.data.wk - 0.5
          && request.resource.data.e >= 0
          && request.resource.data.e <= decE(resource.data.e) - request.resource.data.wk + 0.5
          && request.resource.data.e >= decE(resource.data.e) - request.resource.data.wk - 0.5
          && nearTo(request.resource.data.h, hNow)
          && nearTo(request.resource.data.t, tNow);
      }
      allow update: if isMe(uid) && (
        // 쓰러짐 기록 (그대로): 먹기 기록(eat)은 건드리지 않아요. 물·음식 기록(wk)은 0으로 적어요
        (request.resource.data.keys().hasOnly(['h', 't', 'e', 'at', 'deaths', 'eat', 'wk'])
          && request.resource.data.get('wk', 0) == 0
          && request.resource.data.get('eat', null) == resource.data.get('eat', null)
          && request.time.toMillis() >= resource.data.at
          && request.resource.data.deaths == resource.data.deaths + 1
          && request.resource.data.h == 10 && request.resource.data.t == 10 && request.resource.data.e == 10
          && request.resource.data.at is int
          && request.resource.data.at >= request.time.toMillis() + request.resource.data.deaths * 3600000 - 120000
          && request.resource.data.at <= request.time.toMillis() + request.resource.data.deaths * 3600000 + 120000
          && (resource.data.h - effT() * 100.0 / 86400000.0 <= 2 || resource.data.t - effT() * 100.0 / 64800000.0 <= 2))
        || (request.resource.data.get('wk', null) != null && workOk())
        || (request.resource.data.get('eat', null) != null && eatOk())
      );
    }

    match /wallets/{uid} {
      // 회사 금고(lab)는 센트 단위예요 (1 토큰 = 100 센트). 같은 묶음에서 금고가 정확히 같은 만큼 바뀌어야 해요
      function labDoc(c) { return /databases/$(database)/documents/companies/$(c)/lab/main; }
      function cashIn(c, amt) {
        return (!exists(labDoc(c)) && getAfter(labDoc(c)).data.get('cash', 0) == amt * 100)
          || (exists(labDoc(c)) && get(labDoc(c)).data.get('cash', 0) + amt * 100 == getAfter(labDoc(c)).data.get('cash', 0));
      }
      function cashOut(c, amt) {
        return exists(labDoc(c)) && get(labDoc(c)).data.get('cash', 0) - amt * 100 == getAfter(labDoc(c)).data.get('cash', 0);
      }
      allow get: if isMe(uid);

      // 처음 한 번만, 정해진 금액으로 만들어요 (실명 프로필이 있어야 해요)
      allow create: if isMe(uid)
        && exists(/databases/$(database)/documents/profiles/$(uid))
        && request.resource.data.keys().hasOnly(['bal', 'rate', 't', 'wt', 'op'])
        && request.resource.data.bal == 0
        && request.resource.data.rate == 0
        && request.resource.data.t == request.time
        && request.resource.data.wt == request.time
        && request.resource.data.op == {'kind': 'init'};

      allow update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['bal', 'rate', 't', 'wt', 'op'])
        && request.resource.data.wt == request.time
        && request.time >= resource.data.wt + duration.value(2, 's')
        && request.resource.data.bal is int
        && request.resource.data.bal >= 0
        && request.resource.data.rate is int
        && (
          // 금고에 넣기: 회사 사장만. 같은 묶음에서 지갑 토큰이 빠지고 금고가 그만큼(센트) 늘어요
          (request.resource.data.op.kind == 'deposit'
            && request.resource.data.rate == resource.data.rate
            && request.resource.data.t == resource.data.t
            && request.resource.data.op.cid is string
            && request.resource.data.op.amt is int
            && request.resource.data.op.amt > 0
            && get(companyPath(request.resource.data.op.cid)).data.get('owner', request.resource.data.op.cid) == request.auth.uid
            && cashIn(request.resource.data.op.cid, request.resource.data.op.amt)
            && request.resource.data.bal == resource.data.bal - request.resource.data.op.amt)
          ||
          // 금고에서 빼기: 회사 사장만. 같은 묶음에서 금고가 줄고 지갑에 그만큼 들어와요
          (request.resource.data.op.kind == 'withdraw'
            && request.resource.data.rate == resource.data.rate
            && request.resource.data.t == resource.data.t
            && request.resource.data.op.cid is string
            && request.resource.data.op.amt is int
            && request.resource.data.op.amt > 0
            && get(companyPath(request.resource.data.op.cid)).data.get('owner', request.resource.data.op.cid) == request.auth.uid
            && cashOut(request.resource.data.op.cid, request.resource.data.op.amt)
            && request.resource.data.bal == resource.data.bal + request.resource.data.op.amt)
          ||
          // 상점에서 사기: 같은 묶음에서 파는 회사의 음식 재고가 n개 줄고, 금고가 토큰만큼(센트) 늘어요. 내 지갑은 그 토큰만큼만 줄어요
          (request.resource.data.op.kind == 'shop'
            && request.resource.data.rate == resource.data.rate
            && request.resource.data.t == resource.data.t
            && request.resource.data.op.cid is string
            && request.resource.data.op.pid is string
            && request.resource.data.op.n is int && request.resource.data.op.n >= 1 && request.resource.data.op.n <= 100
            && request.resource.data.op.tokens is int && request.resource.data.op.tokens >= 1
            && request.resource.data.bal == resource.data.bal - request.resource.data.op.tokens
            && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.op.cid)/products/$(request.resource.data.op.pid)).data.get('stock', 0)
               == get(/databases/$(database)/documents/companies/$(request.resource.data.op.cid)/products/$(request.resource.data.op.pid)).data.get('stock', 0) - request.resource.data.op.n
            && cashIn(request.resource.data.op.cid, request.resource.data.op.tokens))
          ||
          // 이자: 걸린 시간만큼의 복리를 넘을 수 없고, 한 번에 최대 7일치예요
          (request.resource.data.op.kind == 'interest'
            && resource.data.rate > 0
            && request.resource.data.rate == resource.data.rate
            && request.resource.data.t > resource.data.t
            && request.resource.data.t <= request.time
            && request.resource.data.t - resource.data.t <= duration.value(7, 'd')
            && request.resource.data.bal > resource.data.bal
            && (request.resource.data.bal - resource.data.bal) <=
               maxGain(resource.data.bal, resource.data.rate, (request.resource.data.t - resource.data.t).seconds()))
          ||
          // 이자 상품 구입: 정해진 값만 내고, 지금보다 높은 이율만 살 수 있어요
          (request.resource.data.op.kind == 'buy'
            && request.resource.data.rate > resource.data.rate
            && request.resource.data.t == request.time
            && request.resource.data.bal == resource.data.bal - prices()[string(request.resource.data.rate)])
          ||
          // 선물 보내기: 같은 묶음에서 만든 선물 메시지의 금액만큼만 줄어요
          (request.resource.data.op.kind == 'gift'
            && request.resource.data.rate == resource.data.rate
            && request.resource.data.t == resource.data.t
            && !exists(msgPath(request.resource.data.op.cid, request.resource.data.op.mid))
            && getAfter(msgPath(request.resource.data.op.cid, request.resource.data.op.mid)).data.type == 'gift'
            && getAfter(msgPath(request.resource.data.op.cid, request.resource.data.op.mid)).data.from == request.auth.uid
            && request.resource.data.bal == resource.data.bal - getAfter(msgPath(request.resource.data.op.cid, request.resource.data.op.mid)).data.amount)
          ||
          // 선물 받기: 받는 사람이 아직 안 받은 선물을 받음으로 바꾸는 묶음에서만, 그 금액만큼 늘어요
          (request.resource.data.op.kind == 'claim'
            && request.resource.data.rate == resource.data.rate
            && request.resource.data.t == resource.data.t
            && get(msgPath(request.resource.data.op.cid, request.resource.data.op.mid)).data.type == 'gift'
            && get(msgPath(request.resource.data.op.cid, request.resource.data.op.mid)).data.to == request.auth.uid
            && get(msgPath(request.resource.data.op.cid, request.resource.data.op.mid)).data.done == false
            && getAfter(msgPath(request.resource.data.op.cid, request.resource.data.op.mid)).data.done == true
            && request.resource.data.bal == resource.data.bal + get(msgPath(request.resource.data.op.cid, request.resource.data.op.mid)).data.amount)
          ||
          // 창업: 같은 묶음에서 새 회사 문서(op.cid)가 만들어지고, 딱 10 토큰만 빠져요. 회사는 여러 개 만들 수 있어요
          (request.resource.data.op.kind == 'found'
            && request.resource.data.rate == resource.data.rate
            && request.resource.data.t == resource.data.t
            && request.resource.data.op.cid is string
            && !exists(companyPath(request.resource.data.op.cid))
            && existsAfter(companyPath(request.resource.data.op.cid))
            && request.resource.data.bal == resource.data.bal - 10)

        );

      // 관리자 토큰 지급: 인증토큰이 맞을 때만, 대상 지갑에 지급한 만큼만 늘어요 (이자 시계와 등급은 그대로예요)
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly(['bal', 'rate', 't', 'wt', 'op'])
        && request.resource.data.wt == request.time
        && request.time >= resource.data.wt + duration.value(2, 's')
        && request.resource.data.rate == resource.data.rate
        && request.resource.data.t == resource.data.t
        && request.resource.data.op.kind == 'grant'
        && request.resource.data.op.amt is int && request.resource.data.op.amt >= 1 && request.resource.data.op.amt <= 1000000
        && request.resource.data.bal == resource.data.bal + request.resource.data.op.amt
        && adminOk(request.resource.data.op.tk);
      allow delete: if isOwner() && adminDelOk();
    }

    // ----- 인벤토리: 내가 가진 음식 (나만 읽고 써요). 상점에서 사거나 사장이 회사 창고에서 꺼내면 늘고, 먹으면 한 개 줄어요 -----
    //   칸 이름은 회사 번호_상품 번호예요. 늘 때는 같은 묶음에서 사기 기록(지갑)이나 창고 줄어듦(상품)이 있어야 해요
    match /inventory/{uid}/items/{id} {
      // old: 지금 칸 수 (새로 만들 때는 0). 없는 문서를 읽으면 오류가 나서 먼저 있는지 확인해요
      function shopPair(old) {
        return exists(walletPath(request.auth.uid))
          && getAfter(walletPath(request.auth.uid)).data.op.kind == 'shop'
          && getAfter(walletPath(request.auth.uid)).data.wt == request.time
          && getAfter(walletPath(request.auth.uid)).data.op.cid == request.resource.data.cid
          && getAfter(walletPath(request.auth.uid)).data.op.pid == request.resource.data.pid
          && request.resource.data.n - old == getAfter(walletPath(request.auth.uid)).data.op.n;
      }
      function takePair(old) {
        return exists(/databases/$(database)/documents/companies/$(request.resource.data.cid)/products/$(request.resource.data.pid))
          && get(/databases/$(database)/documents/companies/$(request.resource.data.cid)/products/$(request.resource.data.pid)).data.get('owner', '') == request.auth.uid
          && request.resource.data.n - old >= 1 && request.resource.data.n - old <= 100000
          && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.cid)/products/$(request.resource.data.pid)).data.get('stock', 0)
             == get(/databases/$(database)/documents/companies/$(request.resource.data.cid)/products/$(request.resource.data.pid)).data.get('stock', 0) - (request.resource.data.n - old);
      }
      function fields() {
        return request.resource.data.keys().hasOnly(['cid', 'pid', 'group', 'name', 'coName', 'item', 'shape', 'color', 'cap', 'capColor', 'content', 'n'])
          && (!('coName' in request.resource.data) || (request.resource.data.coName is string && request.resource.data.coName.size() <= 20))
          && id == request.resource.data.cid + '_' + request.resource.data.pid
          && request.resource.data.cid is string && request.resource.data.pid is string
          && request.resource.data.group in ['water', 'snack', 'meal', 'energy']
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
          && request.resource.data.item is string && request.resource.data.shape is int && request.resource.data.color is int
          && (!('cap' in request.resource.data) || request.resource.data.cap is int)
          && (!('capColor' in request.resource.data) || request.resource.data.capColor is int)
          && (!('content' in request.resource.data) || request.resource.data.content is int);
      }
      allow get: if isMe(uid);
      allow list: if isMe(uid) && request.query.limit <= 100;
      allow create: if isMe(uid) && fields() && request.resource.data.n is int && request.resource.data.n >= 1
        && (shopPair(0) || takePair(0));
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n is int && request.resource.data.n >= 0
        && (
          // 먹기: 한 개 줄어요 (먹기 기록은 먹기 묶음에서 확인해요)
          request.resource.data.n == resource.data.n - 1
          || shopPair(resource.data.n)
          || takePair(resource.data.n)
        );
      allow delete: if false;
    }

    // ----- 공지: 관리자만 써요 (인증토큰 3개가 맞아야 해요). 로그인한 사람은 모두 읽어요.
    // 투표가 있으면 options(2~6개)가 있고, 사람마다 한 번만 골라요 -----
    match /notices/{id} {
      allow get: if signedIn();
      allow list: if isOwner();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['title', 'body', 'by', 'createdAt', 'options', 'tk'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 40
        && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 2000
        && (!request.resource.data.keys().hasAny(['options'])
          || (request.resource.data.options is list && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 6))
        && request.resource.data.createdAt == request.time && request.resource.data.by == request.auth.uid
        && adminOk(request.resource.data.tk);
      allow update, delete: if false;

      // 투표: 내 선택 한 번 (고치기 없음). 오너만 집계를 읽어요
      match /votes/{vid} {
        allow get: if isOwner() || (signedIn() && vid == request.auth.uid);
        allow list: if isOwner();
        allow create: if signedIn() && vid == request.auth.uid
          && request.resource.data.keys().hasOnly(['choice', 'at'])
          && request.resource.data.choice is int && request.resource.data.choice >= 0
          && request.resource.data.choice < get(/databases/$(database)/documents/notices/$(id)).data.options.size()
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // ----- 공지 목록: 오너가 올린 공지 id를 최신순으로 적어요 (인증토큰 확인은 같은 묶음에서) -----
    match /meta/noticeIndex {
      allow get: if signedIn();
      allow write: if isOwner() && adminDelOk() && request.resource.data.keys().hasOnly(['ids'])
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 100;
    }

    // ----- 공지를 어디까지 봤는지 (나만 읽고 써요). 한 번 본 공지는 다시 띄우지 않아요 -----
    match /noticeReads/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['seen'])
        && request.resource.data.seen is map && request.resource.data.seen.size() <= 2000;
      allow delete: if false;
    }

    // ----- 관리 기록 (관리자만 읽고 써요): 계정 데이터를 지운 기록을 남겨요 -----
    match /adminLog/{id} {
      allow get, list: if isOwner();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['tk', 'kind', 'target', 'at'])
        && request.resource.data.at == request.time && request.resource.data.kind == 'delete'
        && adminOk(request.resource.data.tk);
      allow update, delete: if false;
    }

    // ----- 인증토큰: 관리자가 행동하기 전에 앱이 만들어요. 3개와 5분 (그 뒤에는 쓸 수 없어요) -----
    match /adminAuth/{uid} {
      allow get: if isOwner() && uid == request.auth.uid;
      allow create, update: if isOwner() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['tk', 'exp'])
        && request.resource.data.tk is list && request.resource.data.tk.size() == 3
        && request.resource.data.tk[0] is string && request.resource.data.tk[0].size() == 12
        && request.resource.data.tk[1] is string && request.resource.data.tk[1].size() == 12
        && request.resource.data.tk[2] is string && request.resource.data.tk[2].size() == 12
        && request.resource.data.exp > request.time.toMillis()
        && request.resource.data.exp <= request.time.toMillis() + 300000;
      allow delete: if isOwner() && uid == request.auth.uid;
    }

    // ----- 두 사람의 대화 -----
    match /chats/{cid} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if signedIn() && request.auth.uid in resource.data.members && request.query.limit <= 100;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'last', 'lastAt', 'lastFrom', 'reads'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.members[0]))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.members[1]))
        && request.resource.data.last == ''
        && request.resource.data.lastFrom == ''
        && request.resource.data.lastAt == timestamp.date(1970, 1, 1)
        && request.resource.data.reads == {};

      allow update: if signedIn() && request.auth.uid in resource.data.members && (
        // 메시지를 보낼 때: 마지막 글을 갱신하고, 0.6초보다 빨리 연달아 보낼 수 없어요
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'lastAt', 'lastFrom'])
          && request.resource.data.last is string && request.resource.data.last.size() <= 200
          && request.resource.data.lastFrom == request.auth.uid
          && request.resource.data.lastAt == request.time
          && request.time >= resource.data.lastAt + duration.value(600, 'ms'))
        ||
        // 읽음 표시: 내 칸만
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads'])
          && request.resource.data.reads.diff(resource.data.reads).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.reads[request.auth.uid] == request.time)
      );

      match /messages/{mid} {
        function chatDoc() { return get(/databases/$(database)/documents/chats/$(cid)); }
        function body(d) {
          return (d.type == 'text'
                    && d.keys().hasOnly(['type', 'from', 'to', 'at', 'text'])
                    && d.text is string && d.text.size() >= 1 && d.text.size() <= 1000)
              || ((d.type == 'photo' || d.type == 'draw')
                    && d.keys().hasOnly(['type', 'from', 'to', 'at', 'img'])
                    && img(d.img, 140000))
              || (d.type == 'request'
                    && d.keys().hasOnly(['type', 'from', 'to', 'at', 'amount', 'done'])
                    && d.amount is int && d.amount >= 1 && d.amount <= 99999999
                    && d.done == false)
              || (d.type == 'gift'
                    && d.keys().hasOnly(['type', 'from', 'to', 'at', 'amount', 'done'])
                    && d.amount is int && d.amount >= 1 && d.amount <= 99999999
                    && d.done == false
                    // 같은 묶음에서 내 지갑이 그만큼 줄어야 보낼 수 있어요
                    && getAfter(walletPath(request.auth.uid)).data.op.kind == 'gift'
                    && getAfter(walletPath(request.auth.uid)).data.op.mid == mid
                    && getAfter(walletPath(request.auth.uid)).data.op.cid == cid
                    && getAfter(walletPath(request.auth.uid)).data.bal >= 0)
              || (d.type == 'poll'
                    && d.keys().hasOnly(['type', 'from', 'to', 'at', 'poll', 'votes'])
                    && d.votes == {}
                    && d.poll.keys().hasOnly(['q', 'options'])
                    && d.poll.q is string && d.poll.q.size() >= 1 && d.poll.q.size() <= 60
                    && d.poll.options is list && d.poll.options.size() >= 2 && d.poll.options.size() <= 4
                    && opt(d.poll.options[0]) && opt(d.poll.options[1])
                    && (d.poll.options.size() < 3 || opt(d.poll.options[2]))
                    && (d.poll.options.size() < 4 || opt(d.poll.options[3])));
        }
        function opt(o) {
          return o is map && o.keys().hasOnly(['t', 'img'])
              && o.t is string && o.t.size() <= 30
              && o.img is string && (o.img == '' || img(o.img, 50000))
              && (o.t != '' || o.img != '');
        }

        allow get: if signedIn() && request.auth.uid in chatDoc().data.members;
        allow list: if signedIn() && request.auth.uid in chatDoc().data.members && request.query.limit <= 60;

        allow create: if signedIn()
          && request.auth.uid in chatDoc().data.members
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to in chatDoc().data.members
          && request.resource.data.to != request.auth.uid
          && request.resource.data.at == request.time
          // 같은 묶음에서 대화 문서의 마지막 글이 갱신돼야 해요 (속도 제한은 그 갱신이 해요)
          && getAfter(/databases/$(database)/documents/chats/$(cid)).data.lastAt == request.time
          && body(request.resource.data);

        allow update: if signedIn() && request.auth.uid in chatDoc().data.members && (
          // 받기·보냈어요 표시: 받는 사람만, 한 번만
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
            && resource.data.type in ['gift', 'request']
            && resource.data.to == request.auth.uid
            && resource.data.done == false
            && request.resource.data.done == true)
          ||
          // 투표: 내 표만, 선택지 안에서
          (resource.data.type == 'poll'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.votes[request.auth.uid] is int
            && request.resource.data.votes[request.auth.uid] >= 0
            && request.resource.data.votes[request.auth.uid] < resource.data.poll.options.size())
        );
      }
    }
  }
}
